#!/usr/bin/env python
# -*- coding: utf-8 -*-

"""
AI_ModelGenerator.FCMacro
Simple AI 3D Model Generator for FreeCAD using Ollama.
"""

# CONFIGURATION

OLLAMA_URL = "http://127.0.0.1:11434"
OLLAMA_MODEL = "qwen3-coder:480b-cloud"


# IMPORTS

import FreeCAD
import Part
import json
import re
import traceback
import builtins

from urllib.request import Request, urlopen
from urllib.error import URLError

try:
    from PySide2 import QtCore, QtGui, QtWidgets
except ImportError:
    try:
        from PySide6 import QtCore, QtGui, QtWidgets
    except ImportError:
        from PySide import QtCore, QtGui
        QtWidgets = QtGui


# SYSTEM PROMPT

SYSTEM_PROMPT = r"""You are an expert FreeCAD automation engineer. You write Python code that creates 3D models using FreeCAD's Python API.

Rules:
- Output ONLY a single Python code block. No explanations.
- Do NOT import FreeCAD or Part — already available.
- Do NOT create a document — `doc` already exists.
- Always call `doc.recompute()` at the very end.
- All measurements in millimeters (mm).
- Give every object a `.Label`.

Available:
- FreeCAD / App
- Part
- doc (active document)
- Vector, Placement, Rotation
"""


class OllamaClient:
    """Minimal Ollama client using urllib (no extra deps)."""

    def __init__(self, base_url=OLLAMA_URL, model=OLLAMA_MODEL):
        self.base_url = base_url.rstrip("/")
        self.model = model
        self.history = []

    def is_running(self):
        try:
            req = Request(f"{self.base_url}/api/tags")
            urlopen(req, timeout=3)
            return True
        except Exception:
            return False

    def get_models(self):
        try:
            req = Request(f"{self.base_url}/api/tags")
            resp = urlopen(req, timeout=5)
            data = json.loads(resp.read().decode())
            return [m.get("name", m.get("model", "")) for m in data.get("models", [])]
        except Exception:
            return []

    def _chat(self, messages):
        payload = json.dumps(
            {
                "model": self.model,
                "messages": messages,
                "stream": False,
                "options": {
                    "temperature": 0.15,
                    "top_p": 0.9,
                    "num_predict": 4096,
                },
            }
        ).encode("utf-8")

        req = Request(
            f"{self.base_url}/api/chat",
            data=payload,
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        resp = urlopen(req, timeout=300)
        result = json.loads(resp.read().decode())
        return result.get("message", {}).get("content", "")

    def generate(self, prompt, add_to_history=True):
        messages = [{"role": "system", "content": SYSTEM_PROMPT}]
        messages.extend(self.history)
        messages.append(
            {
                "role": "user",
                "content": (
                    "Generate FreeCAD Python code for:\n\n"
                    f"{prompt}\n\n"
                    "Output ONLY Python code. No explanations."
                ),
            }
        )

        raw_text = self._chat(messages)
        code = self._extract_code(raw_text)
        code = self._clean_code(code)

        if add_to_history:
            self.history.append({"role": "user", "content": prompt})
            self.history.append({"role": "assistant", "content": raw_text})
            if len(self.history) > 20:
                self.history = self.history[-20:]

        return code, raw_text

    def fix_code(self, code, error):
        fix_prompt = (
            "This FreeCAD code produced an error. Fix it completely.\n\n"
            f"CODE:\n```python\n{code}\n```\n\n"
            f"ERROR:\n```\n{error}\n```\n\n"
            "Return ONLY the fixed Python code."
        )
        messages = [{"role": "system", "content": SYSTEM_PROMPT}]
        messages.append({"role": "user", "content": fix_prompt})
        raw_text = self._chat(messages)
        code = self._extract_code(raw_text)
        code = self._clean_code(code)
        return code, raw_text

    def clear_history(self):
        self.history.clear()

    @staticmethod
    def _extract_code(text):
        if not text:
            return "doc.recompute()"

        m = re.findall(r"```python\s*\n(.*?)```", text, re.DOTALL)
        if m:
            return "\n\n".join(x.strip() for x in m)

        m = re.findall(r"```\s*\n(.*?)```", text, re.DOTALL)
        if m:
            return "\n\n".join(x.strip() for x in m)

        return text.strip()

    @staticmethod
    def _clean_code(code):
        if not code:
            return code

        skip_markers = [
            "import freecad",
            "import part",
            "from freecad",
            "sys.path",
            "app.newdocument",
            "freecad.newdocument",
            "doc = app",
            "doc = freecad",
            "doc=app",
            "document = app",
        ]
        cleaned = []
        for line in code.split("\n"):
            low = line.strip().lower()
            if any(s in low for s in skip_markers):
                cleaned.append(f"# [auto-removed]: {line}")
            else:
                cleaned.append(line)
        return "\n".join(cleaned)


def execute_code(code, doc):
    """
    Execute generated code inside FreeCAD.
    Returns (success: bool, message: str).
    """
    ns = {
        "FreeCAD": FreeCAD,
        "App": FreeCAD,
        "Part": Part,
        "doc": doc,
        "document": doc,
        "Vector": FreeCAD.Vector,
        "Placement": FreeCAD.Placement,
        "Rotation": FreeCAD.Rotation,
        "range": range,
        "len": len,
        "enumerate": enumerate,
        "zip": zip,
        "map": map,
        "filter": filter,
        "int": int,
        "float": float,
        "str": str,
        "bool": bool,
        "list": list,
        "dict": dict,
        "tuple": tuple,
        "set": set,
        "abs": abs,
        "round": round,
        "min": min,
        "max": max,
        "sum": sum,
        "pow": pow,
        "print": FreeCAD.Console.PrintMessage,
        "sorted": sorted,
        "reversed": reversed,
        "any": any,
        "all": all,
        "isinstance": isinstance,
        "hasattr": hasattr,
        "getattr": getattr,
        "True": True,
        "False": False,
        "None": None,
        "builtins": builtins,
    }

    try:
        import math

        ns["math"] = math
    except Exception:
        pass

    try:
        exec(code, ns)
        return True, "Model created successfully!"
    except Exception as e:
        tb = traceback.format_exc()
        m = re.search(r'File ["\']<string>["\'], line (\d+)', tb)
        if m:
            lineno = int(m.group(1))
            lines = code.split("\n")
            if 1 <= lineno <= len(lines):
                return (
                    False,
                    f"{type(e).__name__}: {e}\n\n"
                    f"Line {lineno}: {lines[lineno - 1].strip()}",
                )
        return False, f"{type(e).__name__}: {e}\n\n{tb}"


class AIModelGeneratorDialog(QtWidgets.QDialog):
    """Main dialog window for the AI 3D Model Generator."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.ollama = OllamaClient()
        self.last_code = ""
        self.generation_count = 0
        self._setup_ui()
        self._check_ollama()

    def _setup_ui(self):
        self.setWindowTitle("AI 3D Model Generator")
        self.setMinimumSize(700, 600)

        root = QtWidgets.QVBoxLayout(self)
        root.setSpacing(8)

        header = QtWidgets.QLabel(
            "AI 3D Model Generator\n"
            "Describe a 3D model → Ollama generates it → appears in FreeCAD"
        )
        header.setAlignment(QtCore.Qt.AlignCenter)
        header.setStyleSheet(
            "font-size:16px; font-weight:bold; padding:10px; color:#2196F3;"
        )
        root.addWidget(header)

        self.status_label = QtWidgets.QLabel("Checking Ollama…")
        self.status_label.setStyleSheet(
            "padding:5px 10px; border-radius:4px; font-weight:bold;"
        )
        root.addWidget(self.status_label)

        row = QtWidgets.QHBoxLayout()
        row.addWidget(QtWidgets.QLabel("Model:"))
        self.model_combo = QtWidgets.QComboBox()
        self.model_combo.setEditable(True)
        self.model_combo.setMinimumWidth(260)
        self.model_combo.addItem(OLLAMA_MODEL)
        row.addWidget(self.model_combo)
        refresh_btn = QtWidgets.QPushButton("Refresh")
        refresh_btn.clicked.connect(self._refresh_models)
        row.addWidget(refresh_btn)
        row.addStretch()
        root.addLayout(row)

        prompt_label = QtWidgets.QLabel("Describe your 3D model:")
        prompt_label.setStyleSheet("font-weight:bold; font-size:13px;")
        root.addWidget(prompt_label)

        self.prompt_input = QtWidgets.QTextEdit()
        self.prompt_input.setPlaceholderText(
            "Examples:\n"
            "• Create a cube with 50mm sides\n"
            "• Plate 200x100x10mm with 4 corner holes of 8mm diameter\n"
            "• Hollow cylinder OD=60mm ID=50mm length=100mm\n"
            "• L-bracket 100x80x10mm with 5mm fillets"
        )
        self.prompt_input.setMaximumHeight(120)
        self.prompt_input.setStyleSheet(
            "QTextEdit{font-size:13px; padding:8px; border:2px solid #ccc; "
            "border-radius:6px;} QTextEdit:focus{border-color:#2196F3;}"
        )
        root.addWidget(self.prompt_input)

        quick_row = QtWidgets.QHBoxLayout()
        for label, text in [
            ("Cube", "Create a cube with 50mm sides"),
            ("Cylinder", "Create a cylinder radius 25mm height 80mm"),
            ("Plate+Holes", "Plate 200x100x10mm with 4 corner holes of 8mm"),
            ("L-Bracket", "L-bracket 100x80x10mm with 5mm fillets"),
        ]:
            btn = QtWidgets.QPushButton(label)
            btn.setMaximumHeight(26)
            btn.setStyleSheet("font-size:11px; padding:2px 6px;")
            btn.clicked.connect(
                lambda _=False, t=text: self.prompt_input.setPlainText(t)
            )
            quick_row.addWidget(btn)
        root.addLayout(quick_row)

        btn_row = QtWidgets.QHBoxLayout()

        self.generate_btn = QtWidgets.QPushButton("Generate Model")
        self.generate_btn.setMinimumHeight(42)
        self.generate_btn.setStyleSheet(
            "QPushButton{font-size:15px; font-weight:bold; "
            "background:#2196F3; color:white; border:none; "
            "border-radius:8px; padding:10px 20px;}"
        )
        self.generate_btn.clicked.connect(self._on_generate)
        btn_row.addWidget(self.generate_btn)

        self.modify_btn = QtWidgets.QPushButton("Add Feature")
        self.modify_btn.setMinimumHeight(42)
        self.modify_btn.setStyleSheet(
            "QPushButton{font-size:13px; font-weight:bold; "
            "background:#4CAF50; color:white; border:none; "
            "border-radius:8px; padding:10px 15px;}"
        )
        self.modify_btn.clicked.connect(self._on_modify)
        btn_row.addWidget(self.modify_btn)

        root.addLayout(btn_row)

        btn_row2 = QtWidgets.QHBoxLayout()
        new_btn = QtWidgets.QPushButton("New Document")
        new_btn.clicked.connect(self._new_document)
        btn_row2.addWidget(new_btn)

        clear_btn = QtWidgets.QPushButton("Clear History")
        clear_btn.clicked.connect(self._clear_history)
        btn_row2.addWidget(clear_btn)

        btn_row2.addWidget(QtWidgets.QLabel("Auto-fix:"))
        self.autofix_check = QtWidgets.QCheckBox()
        self.autofix_check.setChecked(True)
        btn_row2.addWidget(self.autofix_check)
        btn_row2.addStretch()
        root.addLayout(btn_row2)

        code_label = QtWidgets.QLabel("Generated Code:")
        code_label.setStyleSheet("font-weight:bold; font-size:13px;")
        root.addWidget(code_label)

        self.code_output = QtWidgets.QTextEdit()
        self.code_output.setReadOnly(True)
        self.code_output.setStyleSheet(
            "QTextEdit{font-family:'Menlo','Monaco','Courier New',monospace;"
            "font-size:12px; background:#1e1e1e; color:#d4d4d4; padding:10px; "
            "border-radius:6px;}"
        )
        root.addWidget(self.code_output)

        log_label = QtWidgets.QLabel("Log:")
        log_label.setStyleSheet("font-weight:bold;")
        root.addWidget(log_label)

        self.log_output = QtWidgets.QTextEdit()
        self.log_output.setReadOnly(True)
        self.log_output.setMaximumHeight(110)
        self.log_output.setStyleSheet(
            "QTextEdit{font-family:monospace; font-size:11px; "
            "background:#1e1e1e; padding:5px; border-radius:4px;}"
        )
        root.addWidget(self.log_output)

        shortcut = QtWidgets.QShortcut(QtGui.QKeySequence("Ctrl+Return"), self)
        shortcut.activated.connect(self._on_generate)

    def _set_status(self, text, color="black"):
        palette = {
            "green": ("#E8F5E9", "#2E7D32"),
            "red": ("#FFEBEE", "#C62828"),
            "blue": ("#E3F2FD", "#1565C0"),
            "orange": ("#FFF3E0", "#E65100"),
            "black": ("#F5F5F5", "#333333"),
        }
        bg, fg = palette.get(color, palette["black"])
        self.status_label.setText(text)
        self.status_label.setStyleSheet(
            "padding:5px 10px; border-radius:4px; font-weight:bold; "
            f"background-color:{bg}; color:{fg};"
        )

    def _log(self, msg):
        self.log_output.append(msg)
        sb = self.log_output.verticalScrollBar()
        sb.setValue(sb.maximum())
        FreeCAD.Console.PrintMessage(f"[AI-Gen] {msg}\n")

    def _ensure_document(self):
        if FreeCAD.ActiveDocument is None:
            self._new_document()
        return FreeCAD.ActiveDocument

    def _new_document(self):
        self.generation_count += 1
        name = f"AI_Model_{self.generation_count}"
        FreeCAD.newDocument(name)
        self._log(f"New document: {name}")
        self._set_status(f"New document: {name}", "blue")

    def _clear_history(self):
        self.ollama.clear_history()
        self._log("History cleared")
        self._set_status("History cleared", "blue")

    def _display_code(self, code):
        numbered = []
        for i, line in enumerate(code.split("\n"), 1):
            numbered.append(f"{i:4d} │ {line}")
        self.code_output.setPlainText("\n".join(numbered))

    def _fit_view(self):
        try:
            import FreeCADGui

            if FreeCADGui.ActiveDocument and FreeCADGui.ActiveDocument.ActiveView:
                FreeCADGui.ActiveDocument.ActiveView.fitAll()
        except Exception:
            pass

    def _check_ollama(self):
        if self.ollama.is_running():
            self._set_status("Ollama connected", "green")
            self._refresh_models()
        else:
            self._set_status("Ollama not running — start `ollama serve`", "red")
            self.generate_btn.setEnabled(False)
            self.modify_btn.setEnabled(False)

    def _refresh_models(self):
        models = self.ollama.get_models()
        current = self.model_combo.currentText()
        self.model_combo.clear()
        if models:
            self.model_combo.addItems(models)
            idx = self.model_combo.findText(current)
            if idx >= 0:
                self.model_combo.setCurrentIndex(idx)
            self._log(f"Models: {', '.join(models)}")
        else:
            self.model_combo.addItem(OLLAMA_MODEL)
            self._log("Could not fetch models, using default only")

    def _on_generate(self):
        prompt = self.prompt_input.toPlainText().strip()
        if not prompt:
            self._set_status("Enter a description first", "orange")
            return

        self.ollama.model = self.model_combo.currentText()
        self._new_document()
        doc = FreeCAD.ActiveDocument
        self._generate_and_execute(prompt, doc)

    def _on_modify(self):
        prompt = self.prompt_input.toPlainText().strip()
        if not prompt:
            self._set_status("Enter a description first", "orange")
            return

        self.ollama.model = self.model_combo.currentText()
        doc = self._ensure_document()
        enhanced = (
            "The document already has objects. "
            "Do NOT recreate existing shapes. Only add:\n" + prompt
        )
        self._generate_and_execute(enhanced, doc)

    def _generate_and_execute(self, prompt, doc):
        self.generate_btn.setEnabled(False)
        self.modify_btn.setEnabled(False)
        self._set_status("Generating code with Ollama…", "blue")
        self.code_output.clear()
        QtWidgets.QApplication.processEvents()

        try:
            self._log(f"Prompt: {prompt}")
            code, raw = self.ollama.generate(prompt)
            self.last_code = code
            self._display_code(code)
            self._log(
                f"Generated {len(code)} chars, {code.count(chr(10)) + 1} lines"
            )

            self._set_status("Executing code…", "blue")
            QtWidgets.QApplication.processEvents()

            ok, msg = execute_code(code, doc)
            if ok:
                self._set_status("Model created successfully!", "green")
                self._log(f"OK: {msg}")
                self._fit_view()
                return

            self._set_status("Execution error", "red")
            self._log(f"Error: {msg}")

            if self.autofix_check.isChecked():
                self._log("Attempting auto-fix…")
                self._set_status("Auto-fixing code…", "orange")
                QtWidgets.QApplication.processEvents()

                fixed_code, _ = self.ollama.fix_code(code, msg)
                self.last_code = fixed_code
                self._display_code(fixed_code)

                ok2, msg2 = execute_code(fixed_code, doc)
                if ok2:
                    self._set_status("Auto-fix successful!", "green")
                    self._log(f"OK: {msg2}")
                    self._fit_view()
                else:
                    self._set_status("Auto-fix failed", "red")
                    self._log(f"Fix failed: {msg2}")

        except URLError as e:
            self._set_status("Cannot reach Ollama", "red")
            self._log(f"Connection error: {e}")

        except Exception as e:
            self._set_status("Error", "red")
            self._log(traceback.format_exc())

        finally:
            self.generate_btn.setEnabled(True)
            self.modify_btn.setEnabled(True)


def launch():
    """Launch the AI Model Generator dialog."""
    parent = None
    try:
        import FreeCADGui

        parent = FreeCADGui.getMainWindow()
    except Exception:
        parent = None

    dlg = AIModelGeneratorDialog(parent=parent)
    dlg.show()
    return dlg


_dialog = launch()

#!/usr/bin/env python
# -*- coding: utf-8 -*-

"""
🏭 AI 3D Model Generator for FreeCAD
===================================
Type a prompt → Get a 3D model inside FreeCAD.

Uses Ollama (local LLM) to generate FreeCAD Python code and executes it
in the current document. No external Python packages are required.
"""

# ═══════════════════════════════════════════════════
# CONFIGURATION
# ═══════════════════════════════════════════════════

OLLAMA_URL = "http://127.0.0.1:11434"
OLLAMA_MODEL = "qwen3-coder:480b-cloud"  # Change if you prefer another model


# ═══════════════════════════════════════════════════
# IMPORTS
# ═══════════════════════════════════════════════════

import FreeCAD
import Part
import json
import re
import traceback
import builtins

from urllib.request import Request, urlopen
from urllib.error import URLError, HTTPError

try:
    from PySide2 import QtCore, QtGui, QtWidgets
except ImportError:
    try:
        from PySide6 import QtCore, QtGui, QtWidgets
    except ImportError:
        from PySide import QtCore, QtGui
        QtWidgets = QtGui


# SYSTEM PROMPT — teaches the LLM FreeCAD's API

SYSTEM_PROMPT = r"""You are an expert FreeCAD automation engineer. You write Python code that creates 3D models using FreeCAD's Python API.

## CRITICAL RULES:
1. Output ONLY a single Python code block. No explanations.
2. Do NOT import FreeCAD or Part — already available.
3. Do NOT create a document — `doc` already exists.
4. Always call `doc.recompute()` at the very end.
5. All measurements in millimeters (mm).
6. Give every object a `.Label`.

## AVAILABLE VARIABLES:
- `FreeCAD` / `App` — FreeCAD module
- `Part` — Part module
- `doc` — active document
- `Vector(x,y,z)` — FreeCAD.Vector
- `Placement(pos, rot)` — FreeCAD.Placement
- `Rotation(axis, angle)` — FreeCAD.Rotation

## RULES:
- Use doc.addObject(\"Part::Box\", \"Name\") for parametric primitives
- Boolean Cut: .Base and .Tool
- Boolean Fuse: .Shape1 and .Shape2
- Hide intermediates: obj.Visibility = False
- Close wire loops for extrusion
- doc.recompute() MUST be the last call
- Output ONLY code. No text before or after.
"""


# ═══════════════════════════════════════════════════
# OLLAMA API CLIENT (urllib — no extra deps)
# ═══════════════════════════════════════════════════


class OllamaClient:
    """Minimal Ollama chat client using built-in urllib."""

    def __init__(self, base_url=OLLAMA_URL, model=OLLAMA_MODEL):
        self.base_url = base_url.rstrip("/")
        self.model = model
        self.history = []  # list of {role, content}

    def is_running(self):
        """Quick ping to see if Ollama is reachable."""
        try:
            req = Request(f"{self.base_url}/api/tags")
            resp = urlopen(req, timeout=3)
            return getattr(resp, "status", 200) == 200
        except Exception:
            return False

    def get_models(self):
        """Return a list of local model names."""
        try:
            req = Request(f"{self.base_url}/api/tags")
            resp = urlopen(req, timeout=5)
            data = json.loads(resp.read().decode())
            return [m.get("name", m.get("model", "")) for m in data.get("models", [])]
        except Exception:
            return []

    # ── core chat helpers ─────────────────────────

    def _chat(self, messages, stream=False):
        payload = json.dumps(
            {
                "model": self.model,
                "messages": messages,
                "stream": False,  # keep it simple; no streaming here
                "options": {
                    "temperature": 0.15,
                    "top_p": 0.9,
                    "num_predict": 4096,
                },
            }
        ).encode("utf-8")

        req = Request(
            f"{self.base_url}/api/chat",
            data=payload,
            headers={"Content-Type": "application/json"},
            method="POST",
        )

        resp = urlopen(req, timeout=300)
        result = json.loads(resp.read().decode())
        return result.get("message", {}).get("content", "")

    def generate(self, prompt, add_to_history=True):
        """Generate FreeCAD code for the given prompt."""
        messages = [{"role": "system", "content": SYSTEM_PROMPT}]
        messages.extend(self.history)
        messages.append(
            {
                "role": "user",
                "content": (
                    "Generate FreeCAD Python code for:\n\n"
                    f"{prompt}\n\n"
                    "Output ONLY Python code. No explanations."
                ),
            }
        )

        raw_text = self._chat(messages)
        code = self._extract_code(raw_text)
        code = self._clean_code(code)

        if add_to_history:
            self.history.append({"role": "user", "content": prompt})
            self.history.append({"role": "assistant", "content": raw_text})
            if len(self.history) > 20:
                self.history = self.history[-20:]

        return code, raw_text

    def fix_code(self, code, error):
        """Ask the LLM to fix failing FreeCAD code."""
        fix_prompt = (
            "This FreeCAD code produced an error. Fix it completely.\n\n"
            f"CODE:\n```python\n{code}\n```\n\n"
            f"ERROR:\n```\n{error}\n```\n\n"
            "Return ONLY the fixed Python code."
        )
        messages = [{"role": "system", "content": SYSTEM_PROMPT}]
        messages.append(
            {
                "role": "user",
                "content": fix_prompt,
            }
        )
        raw_text = self._chat(messages)
        code = self._extract_code(raw_text)
        code = self._clean_code(code)
        return code, raw_text

    def clear_history(self):
        self.history.clear()

    # ── response post-processing ────────────────

    @staticmethod
    def _extract_code(text):
        """Extract Python code from markdown fences or return raw text."""
        if not text:
            return "doc.recompute()"

        # ```python ... ```
        m = re.findall(r"```python\s*\n(.*?)```", text, re.DOTALL)
        if m:
            return "\n\n".join(x.strip() for x in m)

        # ``` ... ```
        m = re.findall(r"```\s*\n(.*?)```", text, re.DOTALL)
        if m:
            return "\n\n".join(x.strip() for x in m)

        return text.strip()

    @staticmethod
    def _clean_code(code):
        """Strip lines that fight against our pre-built environment."""
        if not code:
            return code

        skip_markers = [
            "import freecad",
            "import part",
            "from freecad",
            "sys.path",
            "app.newdocument",
            "freecad.newdocument",
            "doc = app",
            "doc = freecad",
            "doc=app",
            "document = app",
        ]

        cleaned = []
        for line in code.split("\n"):
            low = line.strip().lower()
            if any(s in low for s in skip_markers):
                cleaned.append(f"# [auto-removed]: {line}")
            else:
                cleaned.append(line)
        return "\n".join(cleaned)


# ═══════════════════════════════════════════════════
# CODE EXECUTION HELPER
# ═══════════════════════════════════════════════════


def execute_code(code, doc):
    """
    Execute generated code inside FreeCAD.
    Returns (success: bool, message: str).
    """
    # Execution namespace
    namespace = {
        "FreeCAD": FreeCAD,
        "App": FreeCAD,
        "Part": Part,
        "doc": doc,
        "document": doc,
        "Vector": FreeCAD.Vector,
        "Placement": FreeCAD.Placement,
        "Rotation": FreeCAD.Rotation,
        # Common builtins
        "range": range,
        "len": len,
        "enumerate": enumerate,
        "zip": zip,
        "map": map,
        "filter": filter,
        "int": int,
        "float": float,
        "str": str,
        "bool": bool,
        "list": list,
        "dict": dict,
        "tuple": tuple,
        "set": set,
        "abs": abs,
        "round": round,
        "min": min,
        "max": max,
        "sum": sum,
        "pow": pow,
        "print": FreeCAD.Console.PrintMessage,
        "sorted": sorted,
        "reversed": reversed,
        "any": any,
        "all": all,
        "isinstance": isinstance,
        "hasattr": hasattr,
        "getattr": getattr,
        "True": True,
        "False": False,
        "None": None,
        "builtins": builtins,
    }

    try:
        import math

        namespace["math"] = math
    except Exception:
        pass

    try:
        exec(code, namespace)
        return True, "Model created successfully!"
    except Exception as e:
        tb = traceback.format_exc()
        m = re.search(r'File ["\']<string>["\'], line (\d+)', tb)
        if m:
            lineno = int(m.group(1))
            lines = code.split("\n")
            if 1 <= lineno <= len(lines):
                return (
                    False,
                    f"{type(e).__name__}: {e}\n\n"
                    f"Line {lineno}: {lines[lineno - 1].strip()}",
                )
        return False, f"{type(e).__name__}: {e}\n\n{tb}"


# ═══════════════════════════════════════════════════
# MAIN DIALOG
# ═══════════════════════════════════════════════════


class AIModelGeneratorDialog(QtWidgets.QDialog):
    """Main dialog window for the AI 3D Model Generator."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.ollama = OllamaClient()
        self.last_code = ""
        self.generation_count = 0
        self._setup_ui()
        self._check_ollama()

    # ── UI ─────────────────────────────────────

    def _setup_ui(self):
        self.setWindowTitle("🏭 AI 3D Model Generator")
        self.setMinimumSize(720, 620)
        self.resize(820, 720)

        layout = QtWidgets.QVBoxLayout(self)
        layout.setSpacing(8)

        # Header
        header = QtWidgets.QLabel(
            "🏭 AI 3D Model Generator\n"
            "Describe a 3D model → Ollama generates it → appears in FreeCAD"
        )
        header.setAlignment(QtCore.Qt.AlignCenter)
        header.setStyleSheet(
            "font-size:16px; font-weight:bold; padding:10px; color:#2196F3;"
        )
        layout.addWidget(header)

        # Status label
        self.status_label = QtWidgets.QLabel("Checking Ollama…")
        self.status_label.setStyleSheet(
            "padding:5px 10px; border-radius:4px; font-weight:bold;"
        )
        layout.addWidget(self.status_label)

        # Model selector
        row = QtWidgets.QHBoxLayout()
        row.addWidget(QtWidgets.QLabel("Model:"))
        self.model_combo = QtWidgets.QComboBox()
        self.model_combo.setMinimumWidth(260)
        self.model_combo.setEditable(True)
        self.model_combo.addItem(OLLAMA_MODEL)
        row.addWidget(self.model_combo)
        refresh_btn = QtWidgets.QPushButton("🔄 Refresh")
        refresh_btn.clicked.connect(self._refresh_models)
        row.addWidget(refresh_btn)
        row.addStretch()
        layout.addLayout(row)

        # Prompt input
        prompt_label = QtWidgets.QLabel("Describe your 3D model:")
        prompt_label.setStyleSheet("font-weight:bold; font-size:13px;")
        layout.addWidget(prompt_label)

        self.prompt_input = QtWidgets.QTextEdit()
        self.prompt_input.setPlaceholderText(
            "Examples:\n"
            "• Create a cube with 50mm sides\n"
            "• Plate 200x100x10mm with 4 corner holes of 8mm diameter\n"
            "• Hollow cylinder OD=60mm ID=50mm length=100mm\n"
            "• L-bracket 100x80x10mm with 5mm fillets"
        )
        self.prompt_input.setMaximumHeight(120)
        self.prompt_input.setStyleSheet(
            "QTextEdit{font-size:13px; padding:8px; border:2px solid #ccc; "
            "border-radius:6px;} QTextEdit:focus{border-color:#2196F3;}"
        )
        layout.addWidget(self.prompt_input)

        # Quick prompts
        quick_row = QtWidgets.QHBoxLayout()
        for label, text in [
            ("📦 Cube", "Create a cube with 50mm sides"),
            ("🔵 Cylinder", "Create a cylinder radius 25mm height 80mm"),
            (
                "🕳️ Plate+Holes",
                "Create a plate 200x100x10mm with 4 corner holes of 8mm",
            ),
            ("📐 L-Bracket", "Create an L-bracket 100x80x10mm with 5mm fillets"),
        ]:
            btn = QtWidgets.QPushButton(label)
            btn.setMaximumHeight(28)
            btn.setStyleSheet("font-size:11px; padding:2px 6px;")
            btn.clicked.connect(
                lambda _=False, t=text: self.prompt_input.setPlainText(t)
            )
            quick_row.addWidget(btn)
        layout.addLayout(quick_row)

        # Action buttons
        btn_row = QtWidgets.QHBoxLayout()

        self.generate_btn = QtWidgets.QPushButton("🚀 Generate Model")
        self.generate_btn.setMinimumHeight(44)
        self.generate_btn.setStyleSheet(
            "QPushButton{font-size:15px; font-weight:bold; "
            "background:#2196F3; color:white; border:none; "
            "border-radius:8px; padding:10px 20px;}"
            "QPushButton:hover{background:#1976D2;}"
            "QPushButton:pressed{background:#0D47A1;}"
            "QPushButton:disabled{background:#90CAF9;}"
        )
        self.generate_btn.clicked.connect(self._on_generate)
        btn_row.addWidget(self.generate_btn)

        self.modify_btn = QtWidgets.QPushButton("➕ Add Feature")
        self.modify_btn.setMinimumHeight(44)
        self.modify_btn.setStyleSheet(
            "QPushButton{font-size:13px; font-weight:bold; "
            "background:#4CAF50; color:white; border:none; "
            "border-radius:8px; padding:10px 15px;}"
            "QPushButton:hover{background:#388E3C;}"
            "QPushButton:disabled{background:#A5D6A7;}"
        )
        self.modify_btn.clicked.connect(self._on_modify)
        btn_row.addWidget(self.modify_btn)

        layout.addLayout(btn_row)

        # Secondary buttons
        btn_row2 = QtWidgets.QHBoxLayout()
        new_btn = QtWidgets.QPushButton("📄 New Document")
        new_btn.clicked.connect(self._new_document)
        btn_row2.addWidget(new_btn)

        clear_btn = QtWidgets.QPushButton("🗑️ Clear History")
        clear_btn.clicked.connect(self._clear_history)
        btn_row2.addWidget(clear_btn)

        btn_row2.addWidget(QtWidgets.QLabel("Auto-fix:"))
        self.autofix_check = QtWidgets.QCheckBox()
        self.autofix_check.setChecked(True)
        btn_row2.addWidget(self.autofix_check)
        btn_row2.addStretch()
        layout.addLayout(btn_row2)

        # Code output
        code_label = QtWidgets.QLabel("Generated Code:")
        code_label.setStyleSheet("font-weight:bold; font-size:13px;")
        layout.addWidget(code_label)

        self.code_output = QtWidgets.QTextEdit()
        self.code_output.setReadOnly(True)
        self.code_output.setStyleSheet(
            "QTextEdit{font-family:'Menlo','Monaco','Courier New',monospace;"
            "font-size:12px; background:#1e1e1e; color:#d4d4d4; padding:10px; "
            "border-radius:6px;}"
        )
        layout.addWidget(self.code_output)

        # Log output
        log_label = QtWidgets.QLabel("Log:")
        log_label.setStyleSheet("font-weight:bold;")
        layout.addWidget(log_label)

        self.log_output = QtWidgets.QTextEdit()
        self.log_output.setReadOnly(True)
        self.log_output.setMaximumHeight(110)
        self.log_output.setStyleSheet(
            "QTextEdit{font-family:monospace; font-size:11px; "
            "background:#f5f5f5; padding:5px; border-radius:4px;}"
        )
        layout.addWidget(self.log_output)

        # Keyboard shortcut: Ctrl+Enter
        shortcut = QtWidgets.QShortcut(QtGui.QKeySequence("Ctrl+Return"), self)
        shortcut.activated.connect(self._on_generate)

    # ── Ollama integration ─────────────────────

    def _check_ollama(self):
        if self.ollama.is_running():
            self._set_status("✅ Ollama connected", "green")
            self._refresh_models()
        else:
            self._set_status(
                "❌ Ollama not running — start it: ollama serve", "red"
            )
            self.generate_btn.setEnabled(False)
            self.modify_btn.setEnabled(False)

    def _refresh_models(self):
        models = self.ollama.get_models()
        current = self.model_combo.currentText()
        self.model_combo.clear()
        if models:
            self.model_combo.addItems(models)
            idx = self.model_combo.findText(current)
            if idx >= 0:
                self.model_combo.setCurrentIndex(idx)
            self._log(f"Available models: {', '.join(models)}")
        else:
            self.model_combo.addItem(OLLAMA_MODEL)
            self._log("Could not list models, using default.")

    # ── helpers ────────────────────────────────

    def _set_status(self, text, color="black"):
        palette = {
            "green": ("#E8F5E9", "#2E7D32"),
            "red": ("#FFEBEE", "#C62828"),
            "blue": ("#E3F2FD", "#1565C0"),
            "orange": ("#FFF3E0", "#E65100"),
            "black": ("#F5F5F5", "#333333"),
        }
        bg, fg = palette.get(color, palette["black"])
        self.status_label.setText(text)
        self.status_label.setStyleSheet(
            "padding:5px 10px; border-radius:4px; font-weight:bold; "
            f"background-color:{bg}; color:{fg};"
        )

    def _log(self, message):
        self.log_output.append(message)
        sb = self.log_output.verticalScrollBar()
        sb.setValue(sb.maximum())
        FreeCAD.Console.PrintMessage(f"[AI-Gen] {message}\n")

    def _ensure_document(self):
        if FreeCAD.ActiveDocument is None:
            self._new_document()
        return FreeCAD.ActiveDocument

    def _new_document(self):
        self.generation_count += 1
        name = f"AI_Model_{self.generation_count}"
        FreeCAD.newDocument(name)
        self._log(f"📄 New document: {name}")
        self._set_status(f"📄 New document: {name}", "blue")

    def _clear_history(self):
        self.ollama.clear_history()
        self._log("🗑️ History cleared")
        self._set_status("History cleared", "blue")

    def _display_code(self, code):
        numbered = []
        for i, line in enumerate(code.split("\n"), 1):
            numbered.append(f"{i:4d} │ {line}")
        self.code_output.setPlainText("\n".join(numbered))

    def _fit_view(self):
        try:
            import FreeCADGui

            if FreeCADGui.ActiveDocument and FreeCADGui.ActiveDocument.ActiveView:
                FreeCADGui.ActiveDocument.ActiveView.fitAll()
        except Exception:
            pass

    # ── main actions ──────────────────────────

    def _on_generate(self):
        """Create a NEW model from the prompt."""
        prompt = self.prompt_input.toPlainText().strip()
        if not prompt:
            self._set_status("⚠️ Enter a description first!", "orange")
            return

        self.ollama.model = self.model_combo.currentText()
        self._new_document()
        doc = FreeCAD.ActiveDocument

        self._generate_and_execute(prompt, doc)

    def _on_modify(self):
        """Add a feature to the EXISTING model."""
        prompt = self.prompt_input.toPlainText().strip()
        if not prompt:
            self._set_status("⚠️ Enter a description first!", "orange")
            return

        self.ollama.model = self.model_combo.currentText()
        doc = self._ensure_document()

        enhanced = (
            "The document already has objects. "
            "Do NOT recreate existing shapes. Only add:\n" + prompt
        )
        self._generate_and_execute(enhanced, doc)

    def _generate_and_execute(self, prompt, doc):
        """Core: call Ollama, show code, execute, optional auto-fix."""
        self.generate_btn.setEnabled(False)
        self.modify_btn.setEnabled(False)
        self._set_status("🤖 Generating code with Ollama…", "blue")
        self.code_output.clear()
        QtWidgets.QApplication.processEvents()

        try:
            # Generate
            self._log(f"Prompt: {prompt[:90]}{'…' if len(prompt) > 90 else ''}")
            code, raw = self.ollama.generate(prompt)
            self.last_code = code
            self._display_code(code)
            self._log(
                f"Generated: {len(code)} chars, {code.count(chr(10)) + 1} lines"
            )

            # Execute
            self._set_status("▶️ Executing code…", "blue")
            QtWidgets.QApplication.processEvents()
            ok, message = execute_code(code, doc)

            if ok:
                self._set_status("🎉 Model created successfully!", "green")
                self._log(f"✅ {message}")
                self._fit_view()
                return

            # If failed, maybe auto-fix
            self._set_status("❌ Execution error", "red")
            self._log(f"❌ {message}")

            if self.autofix_check.isChecked():
                self._log("🔄 Attempting auto-fix with Ollama…")
                self._set_status("🔄 Auto-fixing code…", "orange")
                QtWidgets.QApplication.processEvents()

                fixed_code, _ = self.ollama.fix_code(code, message)
                self.last_code = fixed_code
                self._display_code(fixed_code)

                ok2, message2 = execute_code(fixed_code, doc)
                if ok2:
                    self._set_status("🎉 Auto-fix successful!", "green")
                    self._log(f"✅ {message2}")
                    self._fit_view()
                else:
                    self._set_status("❌ Auto-fix also failed", "red")
                    self._log(f"❌ Fix failed: {message2}")

        except URLError as e:
            self._set_status("❌ Cannot reach Ollama", "red")
            self._log(f"Connection error: {e}")
            self._log("Make sure Ollama is running: ollama serve")

        except Exception as e:
            self._set_status(f"❌ Error: {e}", "red")
            self._log(traceback.format_exc())

        finally:
            self.generate_btn.setEnabled(True)
            self.modify_btn.setEnabled(True)


# ═══════════════════════════════════════════════════
# ENTRY POINT
# ═══════════════════════════════════════════════════


def launch():
    """Launch the AI Model Generator dialog."""
    # In FreeCAD, there is usually already a QApplication instance.
    parent = None
    try:
        import FreeCADGui

        parent = FreeCADGui.getMainWindow()
    except Exception:
        parent = None

    dlg = AIModelGeneratorDialog(parent=parent)
    dlg.show()
    return dlg


_dialog = launch()